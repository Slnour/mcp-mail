# Which mailbox this instance serves. Shown in the server name, its
# instructions and every tool description, so a client with several mail
# connectors can tell them apart. One process = one mailbox.
MAILBOX_LABEL=info@example.com

# Public URL of this instance, no trailing slash.
BASE_URL=https://mcp-mail-info.example.com

# GitHub OAuth app used to authenticate MCP clients. It is only the login
# screen: scope "user" (profile read), and the sole field used is your login.
# See README, "Why a GitHub OAuth app?", for why it is needed.
# Callback URL to register with GitHub: <BASE_URL>/auth/callback
# An OAuth app allows one callback URL, so each instance needs its own app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins allowed to use this server.
# Empty and the server refuses to start.
ALLOWED_GITHUB_LOGINS=

# Stable secret for signing the tokens issued to MCP clients. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=

# --- Mailbox credentials. Full account access, so treat this file as such. ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_NAME=

# --- Where mail may be sent. ---
# Comma-separated. Each entry is either a full address or "@domain" for
# everyone at that domain.
#
# This is the one control here that an email cannot argue with: confirm=true
# is decided by the model, which is reading text written by whoever sent the
# message. Empty disables sending entirely — reading and drafting still work.
ALLOWED_RECIPIENTS=

# Refuse to write to the same recipient twice within this many minutes.
# 0 disables the guard.
DEDUP_MINUTES=0

MAX_BODY_CHARS=50000
MAX_ATTACHMENT_BYTES=5000000

DATA_DIR=/data
HOST=0.0.0.0
PORT=8000
